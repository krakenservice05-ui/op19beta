# ─────────────────────────────────────────────────────────────────────────────
# Elite Games — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Recommended: Neon (neon.tech), Supabase, or Railway — all have free tiers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/elite_games?sslmode=require

# ── Solana RPC (server-side) ──────────────────────────────────────────────────
# Used by backend API routes to verify transactions.
# Recommended for production: Helius (helius.dev) or QuickNode.
# Public mainnet endpoint works for testing but is rate-limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Solana Network ────────────────────────────────────────────────────────────
# mainnet-beta | devnet | testnet
SOLANA_NETWORK=mainnet-beta

# ── Treasury Wallet — Elite Games receiving address ───────────────────────────
# This is the platform's designated Solana receiving wallet.
# It is a PUBLIC address only — never store private keys or seed phrases here.
#
# Elite Games treasury (MetaMask Solana wallet):
TREASURY_WALLET_ADDRESS=2zjwht9zxHA7zeM2kXtcKH6wcbF3KG7Ep6FKzzjyKcLj

# ── Treasury SPL Token Accounts ───────────────────────────────────────────────
# Associated Token Accounts (ATAs) for the treasury wallet.
# These are derived from the treasury address + each token's mint address.
# They must exist on-chain before tokens can be received.
#
# USDT Solana Mainnet mint: Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
# USDC Solana Mainnet mint: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#
# To create token accounts (run once, requires funded wallet):
#   spl-token create-account Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
#   spl-token create-account EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#
# Derived ATA for USDT:
TREASURY_USDT_TOKEN_ACCOUNT=8xqJB37VoEar24MgAuaXZgqABc92ntVRjYWLQxXacoZz
# Derived ATA for USDC:
TREASURY_USDC_TOKEN_ACCOUNT=7k5RU38gGChHVSsa4YU5uuKBtaXmApe6BnXSga9tCboo

# ── Next.js Public (browser-safe) ────────────────────────────────────────────
# NEXT_PUBLIC_ variables are bundled into the browser.
# Only use for non-secret values (public addresses, network name).
NEXT_PUBLIC_TREASURY_WALLET_ADDRESS=2zjwht9zxHA7zeM2kXtcKH6wcbF3KG7Ep6FKzzjyKcLj
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_TREASURY_USDT_TOKEN_ACCOUNT=8xqJB37VoEar24MgAuaXZgqABc92ntVRjYWLQxXacoZz
NEXT_PUBLIC_TREASURY_USDC_TOKEN_ACCOUNT=7k5RU38gGChHVSsa4YU5uuKBtaXmApe6BnXSga9tCboo
